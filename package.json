{
  "name": "contextcut-mcp",
  "version": "1.3.0",
  "description": "AST-based context pruner for LLMs and AI coding agents via the Model Context Protocol (MCP)",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "contextcut-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "test": "npm run build && python3 -m unittest discover -s tests && node --test tests/*.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ast",
    "token-optimizer",
    "context-window",
    "claude",
    "cursor",
    "gemini",
    "agentic-ai"
  ],
  "author": "5tra83r Studios LLC.",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
